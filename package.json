{
  "name": "prime-tv",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/build-info.mjs && next dev -p 3210",
    "build": "node scripts/build-info.mjs && next build",
    "start": "next start -p 3210",
    "lint": "eslint",
    "typecheck": "node scripts/build-info.mjs && next typegen && tsc --noEmit",
    "hash-password": "node scripts/hash-password.mjs",
    "seed:reset": "node scripts/seed.mjs --force",
    "test:smoke": "node scripts/smoke-test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:github": "node scripts/test-github.mjs",
    "mock:github": "node scripts/mock-github.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.58.0",
    "motion": "^12.43.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "uqr": "^0.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "description": "Prime TV — plataforma de Digital Signage da Prime Esthetics",
  "engines": {
    "node": ">=20.9"
  },
  "browserslist": [
    "chrome >= 79",
    "edge >= 79",
    "firefox >= 78",
    "safari >= 14"
  ]
}
