# ---------------------------------------------------------------
# Prime TV — variáveis de ambiente
# Copie para .env.local (desenvolvimento) ou cadastre no Vercel
# (Project → Settings → Environment Variables). Nunca versione os valores reais.
# ---------------------------------------------------------------

# Acesso ao painel -------------------------------------------------
# Gere em /admin/setup (no navegador) ou com: npm run hash-password
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=
# Texto aleatório com pelo menos 32 caracteres (também gerado em /admin/setup)
SESSION_SECRET=

# Repositório onde o conteúdo é gravado ----------------------------
# Token fine-grained com acesso SOMENTE a este repositório:
#   Contents: Read and write · Commit statuses: Read · Deployments: Read
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BRANCH=main

# Endereço público do site (usado nos links das TVs). Ex.: https://tv.primeesthetics.com.br
APP_URL=

# Desenvolvimento local sem GitHub: grava direto nos arquivos do projeto.
# Use somente com "npm run dev". Em produção deixe vazio.
# STORAGE_DRIVER=local

# Opcional: API compatível com GitHub (testes com o simulador local)
# GITHUB_API_URL=https://api.github.com
